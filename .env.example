# NEXUS AI — Örnek Ortam Değişkenleri
# Bu dosyayı '.env' olarak kopyalayıp kendi anahtarlarınızı girebilirsiniz.

# Groq API Anahtarı (Akıllı Zincir / GPT-OSS / Qwen için önerilen)
GROQ_API_KEY=

# Google Gemini API Anahtarı (İsteğe bağlı, yapay zeka çevirisi için)
GEMINI_API_KEY=

# EVREN AI API Anahtarı (İsteğe bağlı, SSYZ)
EVREN_API_KEY=

# NVIDIA NIM API Anahtarı (İsteğe bağlı, tools/ai_refiner.py için)
NVIDIA_API_KEY=
